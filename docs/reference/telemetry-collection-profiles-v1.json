{
  "schema": "goobers.dev/telemetry/collection-profiles/v1",
  "observabilitySchema": "goobers.dev/telemetry/tenant-observability/v1",
  "defaultProfile": "standard",
  "profileField": "goobers.telemetry.profile",
  "structuredPayloadEncoding": "json",
  "correlationFields": [
    "goobers.instance.id",
    "goobers.gaggle",
    "goobers.workflow",
    "goobers.workflow.version",
    "goobers.workflow.digest",
    "goobers.config.generation",
    "goobers.trigger.kind",
    "goobers.run.id",
    "goobers.stage",
    "goobers.attempt.n",
    "trace_id",
    "span_id",
    "goobers.telemetry.record_id"
  ],
  "consentGatedIdentity": [
    "machineName",
    "accountName",
    "instanceRoot",
    "ai.device.id",
    "ai.cloud.roleInstance"
  ],
  "consentGatedPathRoots": [
    "/Users/\u003caccount\u003e",
    "/home/\u003caccount\u003e",
    "/var/home/\u003caccount\u003e",
    "/mnt/\u003cdrive\u003e/Users/\u003caccount\u003e",
    "\u003cdrive\u003e:\\Users\\\u003caccount\u003e",
    "\\\\\u003chost\u003e\\\u003cshare\u003e\\Users\\\u003caccount\u003e",
    "daemon account home directory"
  ],
  "consentGatedPathPlaceholder": "\u003chome\u003e",
  "profiles": [
    {
      "name": "health",
      "health": true,
      "journal": false,
      "traces": false,
      "hostAccountIdentity": false
    },
    {
      "name": "journal",
      "health": true,
      "journal": true,
      "traces": false,
      "hostAccountIdentity": false
    },
    {
      "name": "standard",
      "health": true,
      "journal": true,
      "traces": true,
      "hostAccountIdentity": false
    },
    {
      "name": "diagnostic",
      "health": true,
      "journal": true,
      "traces": true,
      "hostAccountIdentity": true
    }
  ]
}
