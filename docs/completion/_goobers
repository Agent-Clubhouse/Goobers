#compdef goobers

(( $+functions[compdef] )) || {
    autoload -Uz compinit
    compinit
}

_goobers_completion()
{
    local command
    local -a commands flags candidates

    if (( CURRENT == 2 )); then
        commands=(
            'version:print build version, commit, and date (--json for structured output)'
            'init:scaffold an instance root'
            'connect:connect an instance to your own GitHub repository'
            'examples:browse canonical workflow examples embedded in the binary'
            'scaffold:scaffold a goober, workflow, or gaggle'
            'validate:validate an instance or checked-in config source tree'
            'fleet:associate this instance with a Fleet service'
            'up:run the daemon (scheduler + runner + loopback HTTP API)'
            'down:request a live daemon'\''s graceful drain-shutdown from a separate terminal'
            'service:install and manage the platform-supervised daemon'
            'dashboard:serve and open the local operations portal'
            'getting-started:serve and open the guided portal Getting Started walkthrough'
            'run:trigger a run manually (still honors run conditions)'
            'signal:fire an external signal to subscribed workflows'
            'workflow:inspect workflows'
            'status:validate config, show warnings, list runs, report daemon health, or list live agentic stages'
            'stats:show the instance lifetime summary card'
            'trace:show a run'\''s journal events or review verdicts, follow a live run, or show transcripts'
            'escalations:list escalated runs newest first'
            'completion:generate a shell completion script'
            'help:show command or concept help'
            '--version:print the version'
            '-h:show help'
            '--help:show help'
        )
        _describe 'command' commands
        return
    fi

    command="${words[2]}"
    flags=(-h --help)
    case "${command}" in
        version)
            flags+=(--json)
            ;;
        versions)
            flags+=(--json)
            ;;
        init)
            flags+=(--demo --insecure --guided --template --source-tree --json)
            ;;
        connect)
            flags+=(--token-env --seed --replace --json)
            ;;
        preflight)
            flags+=(--distro --launch-wsl)
            ;;
        onboarding)
            case "${words[3]:-}" in
                stub-agent-instructions) flags+=(--source-tree --harness --json) ;;
                stub-sample) flags+=(--destination --work-tracking --token-env --force --json) ;;
            esac
            ;;
        scaffold)
            case "${words[3]:-}" in
                goober) flags+=(--force) ;;
                workflow) flags+=(--force) ;;
                gaggle) flags+=(--force --from) ;;
            esac
            ;;
        agent-kit)
            case "${words[3]:-}" in
                install) flags+=(--harness) ;;
                update) flags+=(--dry-run --write --replace-modified) ;;
            esac
            ;;
        validate)
            flags+=(--json --github-annotations --check-harness --check-repos --source-tree --strict)
            ;;
        lint)
            flags+=(--json --github-annotations --check-harness --check-repos --source-tree --strict)
            ;;
        fix)
            flags+=(--to --write)
            ;;
        doctor)
            flags+=(--k8s --repo --av-exclusions --work-root --kubeconfig --context --report --oidc-issuer --registry --egress --timeout)
            ;;
        netpol-render)
            flags+=(--out --check --baseline --write-baseline --timeout --print-blob-endpoint)
            ;;
        config)
            case "${words[3]:-}" in
                diff) flags+=(--against) ;;
                show) flags+=(--json) ;;
            esac
            ;;
        speech)
            case "${words[3]:-}" in
                preflight) flags+=(--json) ;;
                test) flags+=(--json) ;;
            esac
            ;;
        fleet)
            case "${words[3]:-}" in
                join) flags+=(--url --enrollment-token-file --grant-local-admin --no-grant-local-admin) ;;
                status) flags+=(--json) ;;
            esac
            ;;
        up)
            flags+=(--quiet --diagnostics --notify --skip-preflight --watch-config --drain-timeout --cleanup-spans-only-runs --disable-read-model-reads)
            ;;
        self-update)
            flags+=(--policy --branch --target --health-ticks --health-timeout)
            ;;
        service)
            case "${words[3]:-}" in
                status) flags+=(--json) ;;
            esac
            ;;
        engine-start)
            flags+=(--gaggle --temporal-hostport --temporal-namespace --task-queue --dedupe-key --direct --live-journal)
            ;;
        engine-queues)
            flags+=(--temporal-hostport --temporal-namespace --task-queue --timeout --json)
            ;;
        engine-project)
            flags+=(--gaggle --temporal-hostport --temporal-namespace)
            ;;
        worker)
            flags+=(--instance --blob-store --daemon-api --dispatch-namespace --config-reload-interval --task-queue --temporal-hostport --temporal-namespace --drain-timeout --work-root)
            ;;
        dashboard)
            flags+=(--port --listen --no-open --dev-assets --wait-for-daemon)
            ;;
        getting-started)
            flags+=(--port --no-open --workdir)
            ;;
        run)
            flags+=(--gaggle --pr --no-wait)
            ;;
        approve)
            flags+=(--decision --actor)
            ;;
        override)
            flags+=(--rationale --decision --actor)
            ;;
        rerun-stage)
            flags+=(--addendum --actor)
            ;;
        workflow)
            case "${words[3]:-}" in
                show) flags+=(--dot) ;;
            esac
            ;;
        runs)
            case "${words[3]:-}" in
                list) flags+=(--json --phase --workflow --gaggle --limit) ;;
                du) flags+=(--json) ;;
            esac
            ;;
        status)
            flags+=(--agents --daemon --json --phase --workflow --gaggle --limit --watch --interval)
            ;;
        stats)
            flags+=(--since --json)
            ;;
        features)
            flags+=(--json --dsl-version --used)
            ;;
        schema)
            flags+=(--list --human)
            ;;
        explain)
            flags+=(--human)
            ;;
        blocked)
            case "${words[3]:-}" in
                list) flags+=(--json) ;;
            esac
            ;;
        claims)
            case "${words[3]:-}" in
                list) flags+=(--json --stale --gaggle --provider) ;;
                release) flags+=(--gaggle --provider --force) ;;
            esac
            ;;
        trace)
            flags+=(--json --follow --summary --verdicts --transcripts --transcript)
            ;;
        e2e)
            case "${words[3]:-}" in
                verify) flags+=(--run --gaggle --expected --out --print-runner-class) ;;
                kill-inject) flags+=(--run --stage --stage-class --namespace --poll-timeout --out) ;;
            esac
            ;;
        escalations)
            flags+=(--json)
            case "${words[3]:-}" in
                show) flags+=(--include-verdict) ;;
            esac
            ;;
        telemetry)
            case "${words[3]:-}" in
                stats) flags+=(--json --workflow --gaggle --branch --model --harness-version --group-by --since --until --rebuild) ;;
                errors) flags+=(--json --workflow --gaggle --class --limit --since --until --rebuild) ;;
                export) flags+=(--since --until) ;;
                prune) flags+=(--dry-run) ;;
                prune-orphans) flags+=(--delete --min-age) ;;
                compact) flags+=(--dry-run) ;;
            esac
            ;;
        journal)
            case "${words[3]:-}" in
                redact) flags+=(--run --path --reason --secret-file) ;;
            esac
            ;;
        backlog-health)
            flags+=(--feedback)
            ;;
        backlog-query)
            flags+=(--claim --debug --release --read-only --reconcile)
            ;;
        file-issues)
            flags+=(--check)
            ;;
        reconcile-branches)
            flags+=(--delete --max --min-age --after)
            ;;
        set-milestone)
            flags+=(--item --milestone)
            ;;
        reconcile-post-merge)
            flags+=(--max --lookback)
            ;;
        telemetry-query)
            flags+=(--window --aggregate --learning-action --threshold --format --gaggle --workflow)
            ;;
        docs-churn)
            flags+=(--repo --workflow --gaggle --since --buffer-multiplier --format)
            ;;
        ios-simulator-test)
            flags+=(--project --workspace --scheme --device --runtime --only-testing --result-bundle)
            ;;
        gather-sibling-context)
            flags+=(--no-cache --no-verdict-cache)
            ;;
        apply-verdict)
            flags+=(--gate)
            ;;
        elect-lander)
            flags+=(--gate)
            ;;
        pr-claim)
            flags+=(--release)
            ;;
        remediation-checkpoint)
            flags+=(--budget --escalate --escalation-outcome)
            ;;
        respond-to-findings)
            flags+=(--check)
            ;;
        mcp-io)
            flags+=(--config)
            ;;
    esac
    if [[ "${PREFIX}" == -* ]]; then
        compadd -a flags
        return
    fi

    case "${command}" in
        onboarding)
            if (( CURRENT == 3 )); then
                candidates=(stub-agent-instructions stub-sample)
                _describe -V 'command' candidates
                return
            fi
            ;;
        examples)
            if (( CURRENT == 3 )); then
                candidates=(list show)
                _describe -V 'command' candidates
                return
            elif [[ "${words[3]:-}" == "show" ]] && (( CURRENT == 4 )); then
                candidates=("${(@f)$(command goobers __complete examples 2>/dev/null)}")
                _describe -V 'command' candidates
                return
            fi
            ;;
        scaffold)
            if (( CURRENT == 3 )); then
                candidates=(goober workflow gaggle)
                _describe -V 'command' candidates
                return
            fi
            ;;
        agent-kit)
            if (( CURRENT == 3 )); then
                candidates=(install check update)
                _describe -V 'command' candidates
                return
            fi
            ;;
        config)
            if (( CURRENT == 3 )); then
                candidates=(diff materialize show)
                _describe -V 'command' candidates
                return
            fi
            ;;
        speech)
            if (( CURRENT == 3 )); then
                candidates=(preflight test)
                _describe -V 'command' candidates
                return
            fi
            ;;
        fleet)
            if (( CURRENT == 3 )); then
                candidates=(join status leave)
                _describe -V 'command' candidates
                return
            fi
            ;;
        service)
            if (( CURRENT == 3 )); then
                candidates=(install uninstall stop start status)
                _describe -V 'command' candidates
                return
            fi
            ;;
        run)
            if (( CURRENT == 3 )); then
                candidates=(abort cancel)
                candidates+=("${(@f)$(command goobers __complete workflows 2>/dev/null)}")
                _describe -V 'workflow' candidates
                return
            elif [[ "${words[3]:-}" == "abort" ]] && (( CURRENT == 4 )); then
                candidates=("${(@f)$(command goobers __complete runs 2>/dev/null)}")
                _describe -V 'run id' candidates
                return
            fi
            ;;
        workflow)
            if (( CURRENT == 3 )); then
                candidates=(show)
                _describe -V 'command' candidates
                return
            elif [[ "${words[3]:-}" == "show" ]] && (( CURRENT == 4 )); then
                candidates=("${(@f)$(command goobers __complete workflows 2>/dev/null)}")
                _describe -V 'workflow' candidates
                return
            fi
            ;;
        runs)
            if (( CURRENT == 3 )); then
                candidates=(list du)
                _describe -V 'command' candidates
                return
            fi
            ;;
        workspace)
            if (( CURRENT == 3 )); then
                candidates=(reset)
                _describe -V 'command' candidates
                return
            fi
            ;;
        blocked)
            if (( CURRENT == 3 )); then
                candidates=(list clear)
                _describe -V 'command' candidates
                return
            fi
            ;;
        claims)
            if (( CURRENT == 3 )); then
                candidates=(list release)
                _describe -V 'command' candidates
                return
            fi
            ;;
        trace)
            if (( CURRENT == 3 )); then
                candidates=()
                candidates+=("${(@f)$(command goobers __complete runs 2>/dev/null)}")
                _describe -V 'run id' candidates
                return
            fi
            ;;
        e2e)
            if (( CURRENT == 3 )); then
                candidates=(verify kill-inject)
                _describe -V 'command' candidates
                return
            fi
            ;;
        escalations)
            if (( CURRENT == 3 )); then
                candidates=(show)
                _describe -V 'command' candidates
                return
            elif [[ "${words[3]:-}" == "show" ]] && (( CURRENT == 4 )); then
                candidates=("${(@f)$(command goobers __complete escalations 2>/dev/null)}")
                _describe -V 'escalated run id' candidates
                return
            fi
            ;;
        completion)
            if (( CURRENT == 3 )); then
                candidates=(bash zsh fish powershell)
                _describe -V 'command' candidates
                return
            fi
            ;;
        telemetry)
            if (( CURRENT == 3 )); then
                candidates=(stats errors export prune prune-orphans compact)
                _describe -V 'command' candidates
                return
            fi
            ;;
        journal)
            if (( CURRENT == 3 )); then
                candidates=(redact)
                _describe -V 'command' candidates
                return
            fi
            ;;
        help)
            if (( CURRENT == 3 )); then
                candidates=(all stages instance gaggle goober workflow stage gate harness capability)
                _describe -V 'command' candidates
                return
            fi
            ;;
    esac

    _directories
}

compdef _goobers_completion goobers
