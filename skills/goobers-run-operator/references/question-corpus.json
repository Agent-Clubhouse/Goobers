    "<goobers> journal redact run-101 <instance-root>",
    "<goobers> telemetry prune-orphans --delete <instance-root>",
    "gh issue edit 1445 --repo acme/widgets --add-label triaged",
    "gh pr comment 42 --repo acme/widgets --body approved",
    "gh pr merge 42 --repo acme/widgets",
    "az devops invoke --http-method PATCH --area wit --resource workItems",
    "git checkout main"
  ],
