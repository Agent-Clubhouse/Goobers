{
  "name": "@goobers/portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "tsc --noEmit -p tsconfig.e2e.json && playwright test",
    "test:plant": "node tools/plant-harness.mjs",
    "test:plant:live": "node tools/plant-harness.mjs --live-daemon",
    "test:contract": "vitest run src/api/wireContract.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.17.1",
    "@azure/msal-react": "^5.5.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
