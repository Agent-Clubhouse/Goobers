apiVersion: goobers.dev/v1alpha1
kind: Gaggle
metadata:
  name: "{{ .Name }}"
spec:
  displayName: "{{ .Name }}"
  # The project codebase this gaggle works on. Point this at your own repo.
  project:
    provider: github
    owner: your-org
    name: your-repo
    branch: main
{{- if .ConnectionRef }}
    connectionRef: "{{ .ConnectionRef }}"
{{- end }}
  # The singleton backlog this gaggle draws work from (GAG-004).
  backlog:
    provider: github
    project: your-org/your-repo
    labels:
      - goobers
{{- if .ConnectionRef }}
    connectionRef: "{{ .ConnectionRef }}"
{{- end }}
  isolation:
    namespace: "gaggle-{{ .Name }}"
