{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goobers.dev/schemas/componentization-timing-v1.json",
  "title": "Goobers componentization timing evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "buildContext",
    "repeats",
    "packages",
    "tests",
    "buildTarget",
    "workloads",
    "canceled",
    "finalStatus"
  ],
  "properties": {
    "schema": { "const": "goobers.componentization-timing/v1" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "dirty"],
      "properties": {
        "revision": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
        "dirty": { "type": "boolean" }
      }
    },
    "buildContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goVersion", "compiler", "goos", "goarch", "tags", "cgoEnabled"],
      "properties": {
        "goVersion": { "type": "string", "minLength": 1 },
        "compiler": { "type": "string", "minLength": 1 },
        "goos": { "type": "string", "minLength": 1 },
        "goarch": { "type": "string", "minLength": 1 },
        "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "cgoEnabled": { "enum": ["0", "1"] }
      }
    },
    "repeats": { "type": "integer", "minimum": 1 },
    "packages": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "tests": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "buildTarget": { "type": "string", "minLength": 1 },
    "workloads": {
      "type": "array",
      "items": { "$ref": "#/$defs/workload" }
    },
    "canceled": { "type": "boolean" },
    "finalStatus": { "type": "integer", "minimum": 0, "maximum": 1 }
  },
  "$defs": {
    "commandResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationNs", "exitStatus"],
      "properties": {
        "durationNs": { "type": "integer", "minimum": 0 },
        "exitStatus": { "type": "integer" },
        "error": { "type": "string", "minLength": 1 }
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "minimumNs", "medianNs", "meanNs", "p95Ns", "maximumNs"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "minimumNs": { "type": "integer", "minimum": 0 },
        "medianNs": { "type": "integer", "minimum": 0 },
        "meanNs": { "type": "number", "minimum": 0 },
        "p95Ns": { "type": "integer", "minimum": 0 },
        "maximumNs": { "type": "integer", "minimum": 0 }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "mode",
        "cacheState",
        "command",
        "sampleCount",
        "successfulCount",
        "failedCount",
        "samples",
        "statistics"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["normal", "race"] },
        "cacheState": { "enum": ["cold", "warm"] },
        "command": {
          "type": "object",
          "additionalProperties": false,
          "required": ["executable", "argv"],
          "properties": {
            "executable": { "const": "go" },
            "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        },
        "prime": { "$ref": "#/$defs/commandResult" },
        "sampleCount": { "type": "integer", "minimum": 0 },
        "successfulCount": { "type": "integer", "minimum": 0 },
        "failedCount": { "type": "integer", "minimum": 0 },
        "samples": { "type": "array", "items": { "$ref": "#/$defs/commandResult" } },
        "statistics": { "$ref": "#/$defs/statistics" }
      }
    }
  }
}
