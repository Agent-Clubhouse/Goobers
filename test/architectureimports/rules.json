{
  "module": "github.com/goobers/goobers",
  "builds": [
    {
      "name": "linux",
      "goos": "linux",
      "goarch": "amd64"
    },
    {
      "name": "macos",
      "goos": "darwin",
      "goarch": "amd64"
    },
    {
      "name": "windows",
      "goos": "windows",
      "goarch": "amd64"
    }
  ],
  "forbidden": [
    {
      "path": "github.com/goobers/goobers/cmd/goobers",
      "rationale": "package main owns CLI registration, flags, environment resolution, construction, and exit mapping"
    },
    {
      "path": "github.com/goobers/goobers/internal/bootstrap",
      "rationale": "daemon and runner composition is an adapter responsibility"
    },
    {
      "path": "github.com/goobers/goobers/internal/dispatcher",
      "rationale": "stage-runner construction is outside pilot domain behavior"
    },
    {
      "path": "github.com/goobers/goobers/internal/engine",
      "rationale": "workflow-runner construction is outside pilot domain behavior"
    },
    {
      "path": "github.com/goobers/goobers/internal/runner",
      "rationale": "runner construction is an adapter responsibility"
    },
    {
      "path": "github.com/goobers/goobers/internal/workerhost",
      "rationale": "worker construction is outside pilot domain behavior"
    }
  ],
  "closureRules": [
    {
      "name": "local-runtime-excludes-cloud",
      "roots": [
        "github.com/goobers/goobers/cmd/goobers",
        "github.com/goobers/goobers/internal/runner",
        "github.com/goobers/goobers/internal/localscheduler",
        "github.com/goobers/goobers/internal/journal",
        "github.com/goobers/goobers/internal/livejournal",
        "github.com/goobers/goobers/internal/readmodel",
        "github.com/goobers/goobers/internal/triggerqueue"
      ],
      "forbidden": [
        {
          "path": "github.com/jackc/pgx",
          "rationale": "Postgres belongs only to the cloud control-plane implementation"
        },
        {
          "path": "github.com/Azure/azure-sdk-for-go/sdk/storage/azblob",
          "rationale": "object-storage clients belong only to the cloud control-plane implementation"
        },
        {
          "path": "github.com/aws/aws-sdk-go",
          "rationale": "S3 clients belong only to a future cloud object-store implementation"
        },
        {
          "path": "github.com/aws/aws-sdk-go-v2",
          "rationale": "S3 clients belong only to a future cloud object-store implementation"
        },
        {
          "path": "github.com/minio/minio-go",
          "rationale": "S3-compatible clients belong only to a future cloud object-store implementation"
        },
        {
          "path": "github.com/goobers/goobers/internal/cloud",
          "rationale": "local runtimes must not depend on cloud-only packages"
        }
      ]
    },
    {
      "name": "cloud-control-excludes-runner",
      "roots": [
        "github.com/goobers/goobers/cmd/goobers-cloud"
      ],
      "forbidden": [
        {
          "path": "github.com/goobers/goobers/internal/runner",
          "rationale": "D-2: cloud control must never construct an in-process stage runner"
        }
      ],
      "reviewedEdges": [
        {
          "from": "github.com/goobers/goobers/internal/workerhost",
          "to": "github.com/goobers/goobers/internal/runner",
          "rationale": "Existing worker workspace default only; remove under #7848 after #7837 runtimewiring extraction. No engine or controller exception."
        }
      ]
    },
    {
      "name": "engine-excludes-local-runner",
      "roots": [
        "github.com/goobers/goobers/internal/engine",
        "github.com/goobers/goobers/internal/runsemantics"
      ],
      "forbidden": [
        {
          "path": "github.com/goobers/goobers/internal/runner",
          "rationale": "Shared engine semantics must not link local executor construction (HA-P3-18, D-2)."
        }
      ]
    }
  ],
  "lanes": [
    {
      "path": "github.com/goobers/goobers/internal/docchurn",
      "decision": "accepted",
      "rationale": "The planned docs-churn domain may use only its durability and configuration boundaries; Git execution and CLI construction stay in the adapter.",
      "allowedDirect": [
        "github.com/goobers/goobers/internal/configboundary",
        "github.com/goobers/goobers/internal/platform/durability"
      ],
      "allowedTransitive": [
        "github.com/goobers/goobers/internal/configboundary",
        "github.com/goobers/goobers/internal/platform/durability"
      ]
    },
    {
      "path": "github.com/goobers/goobers/internal/contention",
      "decision": "accepted",
      "rationale": "Contention owns provider-neutral query and ranking behavior and may reuse provider contracts without constructing a provider or runner.",
      "allowedDirect": [
        "github.com/goobers/goobers/providers"
      ],
      "allowedTransitive": [
        "github.com/goobers/goobers/api/integrity",
        "github.com/goobers/goobers/api/v1alpha1",
        "github.com/goobers/goobers/internal/claimrelease",
        "github.com/goobers/goobers/internal/diagnostics/featureusage",
        "github.com/goobers/goobers/internal/fieldpredicate",
        "github.com/goobers/goobers/internal/jcs",
        "github.com/goobers/goobers/internal/journal",
        "github.com/goobers/goobers/internal/labelpredicate",
        "github.com/goobers/goobers/internal/lifecycle",
        "github.com/goobers/goobers/internal/mutationreceipt",
        "github.com/goobers/goobers/internal/panicguard",
        "github.com/goobers/goobers/internal/pathutil",
        "github.com/goobers/goobers/internal/platform/activetime",
        "github.com/goobers/goobers/internal/platform/durability",
        "github.com/goobers/goobers/internal/platform/lock",
        "github.com/goobers/goobers/internal/platform/safeopen",
        "github.com/goobers/goobers/internal/presentation",
        "github.com/goobers/goobers/internal/readprobe",
        "github.com/goobers/goobers/internal/safeio",
        "github.com/goobers/goobers/internal/secretpattern",
        "github.com/goobers/goobers/internal/sharedclaim",
        "github.com/goobers/goobers/internal/stringpolicy",
        "github.com/goobers/goobers/internal/truncate",
        "github.com/goobers/goobers/internal/version",
        "github.com/goobers/goobers/providers"
      ]
    },
    {
      "path": "github.com/goobers/goobers/internal/prstatus",
      "decision": "accepted",
      "rationale": "PR-status owns request and result behavior and may reuse provider contracts without provider, credential, CLI, or runner construction.",
      "allowedDirect": [
        "github.com/goobers/goobers/internal/platform/durability",
        "github.com/goobers/goobers/providers"
      ],
      "allowedTransitive": [
        "github.com/goobers/goobers/api/integrity",
        "github.com/goobers/goobers/api/v1alpha1",
        "github.com/goobers/goobers/internal/claimrelease",
        "github.com/goobers/goobers/internal/diagnostics/featureusage",
        "github.com/goobers/goobers/internal/fieldpredicate",
        "github.com/goobers/goobers/internal/jcs",
        "github.com/goobers/goobers/internal/journal",
        "github.com/goobers/goobers/internal/labelpredicate",
        "github.com/goobers/goobers/internal/lifecycle",
        "github.com/goobers/goobers/internal/mutationreceipt",
        "github.com/goobers/goobers/internal/panicguard",
        "github.com/goobers/goobers/internal/pathutil",
        "github.com/goobers/goobers/internal/platform/activetime",
        "github.com/goobers/goobers/internal/platform/durability",
        "github.com/goobers/goobers/internal/platform/lock",
        "github.com/goobers/goobers/internal/platform/safeopen",
        "github.com/goobers/goobers/internal/presentation",
        "github.com/goobers/goobers/internal/readprobe",
        "github.com/goobers/goobers/internal/safeio",
        "github.com/goobers/goobers/internal/secretpattern",
        "github.com/goobers/goobers/internal/sharedclaim",
        "github.com/goobers/goobers/internal/stringpolicy",
        "github.com/goobers/goobers/internal/truncate",
        "github.com/goobers/goobers/internal/version",
        "github.com/goobers/goobers/providers"
      ]
    }
  ]
}
