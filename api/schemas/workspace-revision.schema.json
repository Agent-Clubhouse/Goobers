{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goobers.dev/schemas/workspace-revision.schema.json",
  "title": "WorkspaceRevision",
  "description": "Immutable repository identity and exact object binding established only by a successful deterministic result.",
  "type": "object",
  "additionalProperties": false,
  "required": ["repository", "commitSha"],
  "properties": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "owner", "name"],
      "properties": {
        "provider": {"type": "string", "enum": ["github", "ado", "gitea"]},
        "url": {"type": "string"},
        "owner": {"type": "string", "minLength": 1},
        "project": {"type": "string"},
        "name": {"type": "string", "minLength": 1},
        "id": {"type": "string"}
      }
    },
    "commitSha": {"$ref": "#/$defs/sha"},
    "sourceRef": {"type": "string"},
    "sourceId": {"type": "string"},
    "baseRepository": {"$ref": "#/properties/repository"},
    "baseSha": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    }
  }
}
