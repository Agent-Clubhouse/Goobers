{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goobers.dev/schemas/result.schema.json",
  "title": "ResultEnvelope",
  "description": "The V0 stage result envelope the runner acts on; consumed by gates and telemetry (ARCHITECTURE.md \u00a75). Bulk outputs are artifact pointers; outputs carries scalars only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failure",
        "blocked",
        "no-work"
      ]
    },
    "outputs": {
      "type": "object",
      "description": "Small declared scalar values only. Anything larger is an artifact, referenced by pointer \u2014 state does not travel through outputs.",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean",
          "null"
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "artifact-pointer.schema.json"
      }
    },
    "transcript": {
      "description": "Runner-captured transcript for this agentic attempt. Diagnostic only; unlike artifacts, it is not passed to downstream stages.",
      "$ref": "artifact-pointer.schema.json"
    },
    "summary": {
      "type": "string"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "error": {
      "$ref": "#/$defs/errorInfo"
    },
    "integrity": {
      "type": "string",
      "enum": [
        "trusted",
        "maintainer",
        "unapproved",
        "derived"
      ],
      "description": "Provenance of the content this stage produced: the weakest grade among the inputs it was admitted with. Downstream stages resolving inputsFrom grade against this, because outputs are bare scalars that carry no label of their own."
    },
    "workspaceRevision": {
      "description": "Optional immutable repository and exact-object authority. It is established only by a successful deterministic result and is absent for legacy workflows.",
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commitSha"],
      "properties": {
        "repository": { "$ref": "#/$defs/repositoryIdentity", "description": "Canonical repository identity." },
        "commitSha": { "$ref": "#/$defs/sha", "description": "Full lowercase Git object ID." },
        "sourceRef": { "type": "string", "description": "Optional source reference provenance." },
        "sourceId": { "type": "string", "description": "Optional source identifier provenance." },
        "baseRepository": { "$ref": "#/$defs/repositoryIdentity", "description": "Optional base repository provenance." },
        "baseSha": { "$ref": "#/$defs/sha", "description": "Optional full lowercase base object ID." }
      }
    }
  },
  "allOf": [
    {
      "comment": "A failure result must carry error detail.",
      "if": {
        "properties": {
          "status": {
            "const": "failure"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "error"
        ]
      }
    }
  ],
  "$defs": {
    "errorInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
      "sha": {
        "description": "A full lowercase Git SHA-1 or SHA-256 object ID.",
        "type": "string",
        "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
      },
      "repositoryIdentity": {
        "description": "Closed canonical repository identity; routing policy is not included.",
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "owner", "name"],
        "properties": {
          "provider": { "type": "string", "enum": ["github", "ado", "gitea"], "description": "Provider kind." },
          "url": { "type": "string", "format": "uri", "description": "Service URL, when required to distinguish hosts." },
          "owner": { "type": "string", "minLength": 1, "description": "Repository owner or organization." },
          "project": { "type": "string", "description": "Azure DevOps project." },
          "name": { "type": "string", "minLength": 1, "description": "Repository name." },
          "id": { "type": "string", "description": "Provider-native repository identifier." }
        }
    }
  }
}
