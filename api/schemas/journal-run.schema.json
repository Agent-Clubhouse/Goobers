{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goobers.dev/schemas/journal-run.schema.json",
  "title": "JournalRun",
  "description": "run.yaml — the pinned identity of a run (ARCHITECTURE.md §4). Written once at run start and never edited: a run records the workflow definition (name, version, and content digest) it starts and completes on (WF-016), plus the trigger and content-digested input snapshots.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "runId", "workflow", "workflowVersion", "gaggle", "trigger", "startedAt"],
  "properties": {
    "schema": { "const": "goobers.dev/journal/run/v1", "description": "Version of the run identity document." },
    "runId": {
      "description": "Run identifier — the OpenTelemetry trace id for the run.",
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "workflow": { "type": "string", "minLength": 1, "description": "Workflow definition name." },
    "workflowVersion": { "type": "integer", "minimum": 0, "description": "Pinned workflow definition version." },
    "workflowDigest": {
      "description": "Content digest of the pinned workflow Definition (WF-016 tamper-evident pin).",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gooberDigest": {
      "description": "Content digest of the participating resolved goobers, including instruction content, skills, model, and harness configuration.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "continuedFromRunId": {
      "description": "The terminal source run this continuation was created from.",
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "sourceTerminalSeq": {
      "description": "The immutable terminal journal sequence selected from the source run.",
      "type": "integer",
      "minimum": 1
    },
    "operator": { "type": "string", "minLength": 1, "description": "Operator who requested the continuation." },
    "requestedTarget": { "type": "string", "minLength": 1, "description": "Workflow state selected for the continuation." },
    "gaggle": { "type": "string", "minLength": 1, "description": "Gaggle that owns the run." },
    "runControls": {
      "description": "Effective inherited run-control policy pinned when the run started. Omitted only on legacy journals.",
      "type": "object",
      "additionalProperties": false,
      "required": ["maxRepasses", "stalledRunTimeout"],
      "properties": {
        "maxRepasses": { "type": "integer", "minimum": 1, "description": "Pinned maximum gate repasses." },
        "stalledRunTimeout": { "type": "string", "minLength": 1, "description": "Pinned stalled-run timeout." },
        "maxRunDuration": { "type": "string", "minLength": 1, "description": "Resolved maximum total wall-clock age of the run; omitted when disabled." }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "description": "What caused the run to start.",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["manual", "schedule", "signal", "item"], "description": "Trigger kind." },
        "ref": { "type": "string", "description": "Trigger-specific reference." }
      }
    },
    "inputs": {
      "type": "array",
      "description": "Content-digested immutable input snapshots.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "description": "One immutable input snapshot.",
        "required": ["name", "ref"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "description": "Input name." },
          "integrity": {
            "type": "string",
            "enum": ["trusted", "maintainer", "unapproved", "derived"],
            "description": "Provenance grade of this immutable input snapshot."
          },
          "ref": {
            "type": "object",
            "additionalProperties": false,
            "description": "Content-addressed snapshot reference.",
            "required": ["path", "digest", "size"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "description": "Journal-relative snapshot path." },
              "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "SHA-256 content digest." },
              "size": { "type": "integer", "minimum": 0, "description": "Snapshot byte size." },
              "mediaType": { "type": "string", "description": "Snapshot media type." },
              "integrity": {
                "type": "string",
                "enum": ["trusted", "maintainer", "unapproved", "derived"],
                "description": "Provenance grade of this snapshot's content blob."
              }
            }
          }
        }
      }
    },
    "startedAt": { "type": "string", "format": "date-time", "description": "Time the run was created." }
  }
}
