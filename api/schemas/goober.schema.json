{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goobers.dev/schemas/goober.schema.json",
  "title": "Goober",
  "description": "A role-specialized AI worker defined as code (GBO-001/GBO-002).",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "goobers.dev/v1alpha1" },
    "kind": { "const": "Goober" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gaggle", "role", "instructions"],
      "properties": {
        "gaggle": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string" },
        "instructions": { "type": "string", "minLength": 1 },
        "harness": { "type": "string", "enum": ["copilot"] },
        "model": { "type": "string" },
        "harnessOptions": { "type": "object", "additionalProperties": true },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "policyActions": {
          "description": "Closed vocabulary of externally mutating actions this persona unconditionally prescribes. Invoking tasks must redeclare every action and grant its canonical capability.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "conditionalPolicyActions": {
          "description": "Persona actions enabled only when an invoking task explicitly declares the action and grants its canonical capability.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "skills": { "type": "array", "items": { "type": "string" } },
        "tools": { "type": "array", "items": { "type": "string" } },
        "mcpServers": {
          "type": "array",
          "items": { "$ref": "#/$defs/mcpServer" }
        },
        "scaleFactor": { "type": "integer", "minimum": 1 },
        "workflows": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "metadata": {
      "description": "Deliberately left open (no additionalProperties:false) unlike the rest of this schema: k8s-style metadata objects tolerate forward-compatible extra fields (e.g. a future resourceVersion) by convention (#125).",
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "mcpServer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "command": { "type": "string", "minLength": 1 },
        "args": {
          "type": "array",
          "items": { "type": "string" }
        },
        "url": { "type": "string", "format": "uri" },
        "credentialRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/mcpCredentialRef" }
        }
      },
      "oneOf": [
        {
          "required": ["command"],
          "not": { "anyOf": [{ "required": ["url"] }] }
        },
        {
          "required": ["url"],
          "not": { "anyOf": [{ "required": ["command"] }, { "required": ["args"] }] }
        }
      ]
    },
    "mcpCredentialRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability"],
      "properties": {
        "capability": { "type": "string", "minLength": 1 },
        "env": { "type": "string", "minLength": 1 },
        "header": { "type": "string", "minLength": 1 },
        "scheme": { "type": "string", "enum": ["bearer", "basic"] }
      },
      "oneOf": [
        {
          "required": ["env"],
          "not": { "anyOf": [{ "required": ["header"] }, { "required": ["scheme"] }] }
        },
        {
          "required": ["header"],
          "not": { "anyOf": [{ "required": ["env"] }] }
        }
      ]
    }
  }
}
