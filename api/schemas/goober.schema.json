{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goobers.dev/schemas/goober.schema.json",
  "title": "Goober",
  "description": "A role-specialized AI worker defined as code (GBO-001/GBO-002).",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "goobers.dev/v1alpha1", "description": "API version of this goober definition." },
    "kind": { "const": "Goober", "description": "Definition kind; always Goober." },
    "metadata": { "$ref": "#/$defs/metadata", "description": "Identity and optional labels or annotations for this goober." },
    "spec": {
      "type": "object",
      "description": "The goober's role, instruction source, harness configuration, and granted authority.",
      "additionalProperties": false,
      "required": ["gaggle", "role", "instructions"],
      "properties": {
        "gaggle": { "type": "string", "minLength": 1, "examples": ["example"], "description": "Name of the gaggle this goober belongs to." },
        "role": { "type": "string", "minLength": 1, "examples": ["author"], "description": "Role specialization, such as coder, reviewer, or perf-hunter." },
        "displayName": { "type": "string", "description": "Human-facing goober name shown in the portal." },
        "instructions": { "type": "string", "minLength": 1, "examples": ["instructions.md"], "description": "Markdown instruction file path relative to the goober definition directory." },
        "harness": { "type": "string", "enum": ["copilot", "claude-code"], "description": "Agent harness used for this goober. Omitted defaults to copilot." },
        "model": { "type": "string", "description": "Harness-specific model name, validated by the selected adapter before a run starts." },
        "harnessOptions": { "type": "object", "description": "Opaque harness-specific settings validated by the selected adapter.", "additionalProperties": true },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "description": "Default per-attempt wall-clock limit for this goober's agentic stages. A task timeout takes precedence." },
        "capabilities": {
          "type": "array",
          "description": "Credential capability grants this goober may use. Invoking tasks may grant only a subset.",
          "items": {
            "type": "string",
            "enum": [
              "repo:read",
              "repo:push",
              "github:issues:read",
              "github:issues:write",
              "github:milestones:write",
              "github:issues:approve",
              "provider:pr:write",
              "github:pr:write",
              "github:pr:review",
              "github:branch:delete",
              "github:pr:merge",
              "contents:read",
              "ado:code:read",
              "ado:pr:comment",
              "ado:pr:write",
              "ado:pr:status",
              "ado:pr:complete",
              "ado:work-items:write",
              "telemetry:read",
              "journal:read",
              "agent:model"
            ]
          }
        },
        "policyActions": {
          "description": "Closed vocabulary of externally mutating actions this persona unconditionally prescribes. Invoking tasks must redeclare every action and grant its canonical capability.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "approve-issue",
              "assign-milestone",
              "claim-backlog-items",
              "clear-healed-demotions",
              "clear-healed-escalations",
              "clear-remediation",
              "close-issue",
              "close-issues",
              "close-pr",
              "comment-on-issue",
              "create-issue",
              "delete-branch",
              "demote-pr",
              "edit-issue",
              "escalate-pr",
              "fan-out-remediation",
              "flag-foundation-coupling",
              "flag-scope-drift",
              "label-issue",
              "merge-pr",
              "modify-repository",
              "open-or-update-pr",
              "publish-review",
              "push-pr-branch",
              "push-repository-branch",
              "rebase-pr",
              "record-merge-refusal",
              "record-remediation-checkpoint",
              "release-backlog-claim",
              "release-pr-claim",
              "respond-to-findings",
              "resolve-review-threads",
              "rework-pr",
              "route-queue-outcome",
              "route-provider-verdict",
              "route-verdict",
              "unpark-resolved-siblings",
              "update-issue",
              "update-pr-branch",
              "watch-merge-queue"
            ]
          }
        },
        "conditionalPolicyActions": {
          "description": "Persona actions enabled only when an invoking task explicitly declares the action and grants its canonical capability.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "approve-issue",
              "assign-milestone",
              "claim-backlog-items",
              "clear-healed-demotions",
              "clear-healed-escalations",
              "clear-remediation",
              "close-issue",
              "close-issues",
              "close-pr",
              "comment-on-issue",
              "create-issue",
              "delete-branch",
              "demote-pr",
              "edit-issue",
              "escalate-pr",
              "fan-out-remediation",
              "flag-foundation-coupling",
              "flag-scope-drift",
              "label-issue",
              "merge-pr",
              "modify-repository",
              "open-or-update-pr",
              "publish-review",
              "push-pr-branch",
              "push-repository-branch",
              "rebase-pr",
              "record-merge-refusal",
              "record-remediation-checkpoint",
              "release-backlog-claim",
              "release-pr-claim",
              "respond-to-findings",
              "resolve-review-threads",
              "rework-pr",
              "route-queue-outcome",
              "route-provider-verdict",
              "route-verdict",
              "unpark-resolved-siblings",
              "update-issue",
              "update-pr-branch",
              "watch-merge-queue"
            ]
          }
        },
        "skills": { "type": "array", "description": "Named skills available to this goober.", "items": { "type": "string" } },
        "tools": { "type": "array", "description": "Default-deny allowlist of tools or MCP servers reachable by this goober.", "items": { "type": "string" } },
        "mcpServers": {
          "type": "array",
          "description": "External stdio or remote MCP servers materialized for this goober's harness invocation (Copilot or claude-code).",
          "items": { "$ref": "#/$defs/mcpServer" }
        },
        "scaleFactor": { "type": "integer", "minimum": 1, "description": "Desired replica count for concurrent work. Omitted defaults to one." },
        "workflows": { "type": "array", "description": "Names of workflows that invoke this goober.", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "metadata": {
      "description": "Deliberately left open (no additionalProperties:false) unlike the rest of this schema: k8s-style metadata objects tolerate forward-compatible extra fields (e.g. a future resourceVersion) by convention (#125).",
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "examples": ["offline-goober"],
          "description": "DNS-label-compatible goober name, unique within its gaggle."
        },
        "labels": { "type": "object", "description": "String labels used to organize this goober.", "additionalProperties": { "type": "string" } },
        "annotations": { "type": "object", "description": "Non-identifying string metadata attached to this goober.", "additionalProperties": { "type": "string" } }
      }
    },
    "mcpServer": {
      "type": "object",
      "description": "One invocation-local MCP server. Configure exactly one of command for local stdio or url for remote HTTP.",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "description": "Invocation-local, DNS-label-compatible MCP server name."
        },
        "command": { "type": "string", "minLength": 1, "description": "Executable that starts a local stdio MCP server." },
        "args": {
          "type": "array",
          "description": "Arguments passed directly to command without shell interpretation.",
          "items": { "type": "string" }
        },
        "url": { "type": "string", "format": "uri", "description": "HTTP or HTTPS endpoint of a remote MCP server." },
        "credentialRefs": {
          "type": "array",
          "description": "Explicit first-party capability or named BYO credentials exposed to this server.",
          "items": { "$ref": "#/$defs/mcpCredentialRef" }
        }
      },
      "oneOf": [
        {
          "required": ["command"],
          "not": { "anyOf": [{ "required": ["url"] }] }
        },
        {
          "required": ["url"],
          "not": { "anyOf": [{ "required": ["command"] }, { "required": ["args"] }] }
        }
      ]
    },
    "mcpCredentialRef": {
      "type": "object",
      "description": "Binding from one granted first-party capability or named BYO credential to either a local environment variable or a remote HTTP header.",
      "additionalProperties": false,
      "properties": {
        "capability": {
          "type": "string",
          "description": "Closed first-party Goober capability whose scoped credential is resolved.",
          "enum": [
            "repo:read",
            "repo:push",
            "github:issues:read",
            "github:issues:write",
            "github:milestones:write",
            "github:issues:approve",
            "provider:pr:write",
            "github:pr:write",
            "github:pr:review",
            "github:branch:delete",
            "github:pr:merge",
            "contents:read",
            "ado:code:read",
            "ado:pr:comment",
            "ado:pr:write",
            "ado:pr:status",
            "ado:pr:complete",
            "ado:work-items:write",
            "telemetry:read",
            "journal:read",
            "agent:model"
          ]
        },
        "kind": {
          "type": "string",
          "description": "Credential source kind for a non-capability reference.",
          "enum": ["byo"]
        },
        "ref": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "description": "Name of an operator-provided BYO MCP credential."
        },
        "env": { "type": "string", "minLength": 1, "description": "Environment variable name exposed to a local stdio server. Mutually exclusive with header." },
        "header": { "type": "string", "minLength": 1, "description": "HTTP header name sent to a remote server. Mutually exclusive with env." },
        "scheme": { "type": "string", "enum": ["bearer", "basic"], "description": "Optional authorization scheme prefix for a remote header credential." }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "required": ["capability"],
              "not": { "anyOf": [{ "required": ["kind"] }, { "required": ["ref"] }] }
            },
            {
              "required": ["kind", "ref"],
              "not": { "anyOf": [{ "required": ["capability"] }] }
            }
          ]
        },
        {
          "oneOf": [
            {
              "required": ["env"],
              "not": { "anyOf": [{ "required": ["header"] }, { "required": ["scheme"] }] }
            },
            {
              "required": ["header"],
              "not": { "anyOf": [{ "required": ["env"] }] }
            }
          ]
        }
      ]
    }
  }
}
