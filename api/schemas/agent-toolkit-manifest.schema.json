{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goobers.dev/schemas/agent-toolkit-manifest.schema.json",
  "title": "Goobers Agent Toolkit Manifest",
  "description": "Release-owned inventory and compatibility contract for the portable repository-side agent toolkit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "bundleVersion",
    "producer",
    "dslVersions",
    "ownership",
    "assets",
    "adapters",
    "cliCapabilities"
  ],
  "properties": {
    "$schema": { "const": "https://goobers.dev/schemas/agent-toolkit-manifest.schema.json" },
    "schemaVersion": { "const": "1" },
    "bundleVersion": { "const": "1" },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "commit"],
      "properties": {
        "version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$" },
        "commit": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }
      }
    },
    "dslVersions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dslVersion" }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productRoot", "userOwnedInstructionFiles"],
      "properties": {
        "productRoot": { "const": "payload/.goobers/agent-toolkit" },
        "userOwnedInstructionFiles": {
          "type": "array",
          "const": ["AGENTS.md", "CLAUDE.md", ".github/copilot-instructions.md"]
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/asset" }
    },
    "adapters": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/adapter" }
    },
    "cliCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "optional": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "dslVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "level", "history"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "level": { "type": "string", "enum": ["preview", "supported", "deprecated", "unsupported"] },
        "unsupportedAfter": { "type": "string", "minLength": 1 },
        "replacement": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "history": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["level", "sinceVersion"],
            "properties": {
              "level": { "type": "string", "enum": ["preview", "supported", "deprecated", "unsupported"] },
              "sinceVersion": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size", "mode"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
          "not": {
            "anyOf": [
              { "pattern": "(^|/)\\.\\.(/|$)" },
              { "const": "payload/.goobers/agent-toolkit/manifest.json" }
            ]
          }
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 0 },
        "mode": { "type": "string", "pattern": "^0[0-7]{3}$" }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harness", "path", "instructionTarget", "skills"],
      "properties": {
        "harness": { "type": "string", "enum": ["copilot", "claude", "agents"] },
        "path": { "type": "string", "minLength": 1 },
        "instructionTarget": {
          "type": "string",
          "enum": [".github/copilot-instructions.md", "CLAUDE.md", "AGENTS.md"]
        },
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "uniqueItems": true
        }
      }
    }
  }
}
